{
  "name": "vessertid",
  "version": "0.1.0",
  "description": "JavaScript reactive core library",
  "type": "module",
  "main": "./build/vessertid.cjs",
  "module": "./build/vessertid.module.js",
  "exports": {
    ".": {
      "import": "./build/vessertid.module.js",
      "require": "./build/vessertid.cjs"
    },
    "./src/*": "./src/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Luxarions/VessertID"
  },
  "sideEffects": false,
  "files": [
    "build",
    "LICENSE",
    "package.json",
    "README.md",
    "src"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "browserslist": [
    "> 1%, not dead, not ie 11, not op_mini all"
  ],
  "scripts": {
    "start": "npm run dev",
    "test": "npm run lint",
    "build": "node libs/build.js",
    "dev": "node libs/server.js",
    "lint-core": "eslint src",
    "lint": "npm run lint-core"
  },
  "keywords": [
    "vessertid",
    "javascript",
    "eventbus",
    "eventdispatcher",
    "pubsub",
    "modular",
    "core"
  ],
  "author": "Luxarions",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Luxarions/VessertID/issues"
  },
  "homepage": "https://github.com/Luxarions/VessertID#readme"
}
